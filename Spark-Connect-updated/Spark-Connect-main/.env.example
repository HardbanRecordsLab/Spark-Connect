# ═══════════════════════════════════════════════════════════════
# Spark Connect — Zmienne środowiskowe
# Skopiuj ten plik do .env i uzupełnij wartości
# ═══════════════════════════════════════════════════════════════

# ── OBOWIĄZKOWE ────────────────────────────────────────────────

# Supabase — Settings → API → Project URL i anon/public key
VITE_SUPABASE_URL=https://TWOJ_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Adres aplikacji
VITE_APP_URL=https://spark-connect.hardbanrecordslab.online

# ── PUSH NOTIFICATIONS (VAPID) ─────────────────────────────────
# Generuj: npx web-push generate-vapid-keys
# Klucz PUBLICZNY tutaj, PRYWATNY przez supabase secrets set VAPID_PRIVATE_KEY_JWK
VITE_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9...

# ── CLOUDFLARE R2 — TYLKO PRZEZ SUPABASE SECRETS ──────────────
# ⚠️  Klucze R2 NIE trafiają tutaj — są w Supabase Secrets.
# ⚠️  Nigdy nie dodawaj VITE_ do kluczy R2 — byłyby widoczne publicznie.
#
# Ustaw przez CLI:
#   supabase secrets set R2_ACCOUNT_ID="xxxxxxxx"
#   supabase secrets set R2_ACCESS_KEY_ID="yyyyyyyy"
#   supabase secrets set R2_SECRET_ACCESS_KEY="zzzzzzzz"
#   supabase secrets set R2_PUBLIC_BUCKET="spark-avatars"
#   supabase secrets set R2_CHAT_BUCKET="spark-chat-media"
#   supabase secrets set R2_PRIVATE_BUCKET="spark-private"
#   supabase secrets set R2_PUBLIC_URL="https://media.hardbanrecordslab.online"
#   supabase secrets set R2_CHAT_URL="https://chat.hardbanrecordslab.online"

# ── RESEND EMAIL — TYLKO PRZEZ SUPABASE SECRETS ────────────────
#   supabase secrets set RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"




# LiveKit WebRTC (opcjonalne — dla prawdziwego Roulette)
# VITE_LIVEKIT_HOST=wss://twoj-projekt.livekit.cloud
